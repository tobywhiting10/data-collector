# Paste these into Portainer's stack "Environment variables" (or a local .env). Never commit real values.
# Long random string; Home Assistant sends it as the X-API-Key header.   openssl rand -hex 24
API_KEY=REPLACE_WITH_48_RANDOM_HEX_CHARS
# Website origin allowed to fetch the feed from a browser (comma separated; * = anyone)
CORS_ORIGINS=https://tobywhiting10.com
# Card money split: charity share of the amount AFTER card fees (informational; shown in the feed)
CHARITY_SHARE=0.90
# Estimated card fee. SumUp Solo Lite pay-as-you-go = 1.69 (0.99 on Payments Plus).
FEE_PERCENT=1.69
FEE_FIXED_PENCE=0
COLLECT_INTERVAL_MIN=60
CRUK_URL=https://fundraise.cancerresearchuk.org/page/bussage-christmas-lights-show
# Optional: CRUK_REGEX (see README) only if the page wording changes.
# Buy Me a Coffee webhook signing secret (BMC dashboard > Integrations > your webhook). Required for /api/v1/webhooks/bmc
BMC_WEBHOOK_SECRET=
BMC_CURRENCY=GBP
